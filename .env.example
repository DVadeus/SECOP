# Copia este archivo a .env y rellena los valores. .env está en .gitignore.

# --- API Socrata (datos.gov.co) -------------------------------------------
# App token: https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# --- Cloudflare R2 (API S3) ---------------------------------------------------
# Dashboard de Cloudflare -> R2 -> Manage R2 API Tokens -> Create API token
#   Permiso: Object Read & Write, limitado al bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=secop
# Opcional: si no se define, se deriva como
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
